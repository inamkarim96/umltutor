{
  "name": "umltutor-backend",
  "version": "1.0.0",
  "description": "Backend API for UML Tutor",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "vercel-build": "node scripts/vercel-build.js",
    "build": "node scripts/vercel-build.js",
    "test": "cross-env NODE_ENV=test DATABASE_URL=\"file:./prisma/test.db\" npx prisma db push --accept-data-loss && cross-env NODE_ENV=test DATABASE_URL=\"file:./prisma/test.db\" jest",
    "test:watch": "cross-env NODE_ENV=test DATABASE_URL=\"file:./prisma/test.db\" jest --watch",
    "test:coverage": "cross-env NODE_ENV=test DATABASE_URL=\"file:./prisma/test.db\" jest --coverage",
    "dev": "nodemon --exec node src/server.js",
    "start": "node src/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:studio": "prisma studio",
    "prisma:status": "prisma migrate status",
    "prisma:deploy": "prisma migrate deploy",
    "db:clean": "node src/scripts/clean-db.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^5.1.1",
    "cloudinary": "^2.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^13.7.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.4",
    "nodemon": "^3.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "socket.io": "^4.7.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "ua-parser-js": "^2.0.9",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.22.4",
    "prisma": "^5.22.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.2.0",
    "nodemon": "^3.1.0",
    "supertest": "^7.2.2"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
